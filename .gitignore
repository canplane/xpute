# General OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Dependency directories
node_modules/
jspm_packages/

# AI coding tools
# Assistant-specific directories stay untracked: the committed, vendor-neutral
# content lives in AGENTS.md and .agents/, and these are expected to be local
# symlinks into it (see AGENTS.md "Skills").
# NOTE: git has no inline comments in .gitignore — a trailing `# ...` becomes
# part of the pattern, so these must each sit on their own line.
.claude/
.cursor/
.windsurf/
.codex/
.continue/
.aider*

# Personal, uncommitted variants of shared agent content
.agents/skills/.local/
.agents/**/*.local.md

# Backup files sometimes created by rustfmt/editor tooling
**/*.rs.bk

# Rust workspace build output
/crates/target

# Written by whoever runs the gate here, and not by the export. Two libraries'
# locks bind no consumer, and pixelet's own are what its builds are held to.
/crates/Cargo.lock
/deno.lock
